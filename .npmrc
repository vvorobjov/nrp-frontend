# This project pins a legacy dependency tree (React 17, Material-UI v4,
# TypeScript 4.1, ...). Some dev-only tools declare newer optional peers
# (e.g. msw wants typescript >= 4.4). Use npm v6-style peer resolution so the
# tree installs deterministically instead of hard-failing on optional-peer
# conflicts. Honoured by both `npm install` and `npm ci`.
legacy-peer-deps=true
